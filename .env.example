# ============================================================
# AI Challenge 2025 Backend - Environment Variables
# ============================================================
# Copy this file to `.env` and fill in the values.
# All variables are optional — sensible defaults are provided.
# ============================================================

# --- Server Configuration ---
ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=3000

# --- Data Paths (absolute or relative to src/) ---
# Leave blank to use defaults under src/dict/ and src/data/
FAISS_INDEX_PATH=
METADATA_PATH=
KEYFRAMES_ROOT=
FEATURES_ROOT=
# --- External Services ---
ELASTICSEARCH_URL=http://localhost:9200

# --- CORS ---
# Comma-separated list of allowed origins. Use "*" to allow any origin
# (credentials are disabled automatically in that case).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# --- Model Configuration ---
CLIP_MODEL_NAME=ViT-H-14-quickgelu
CLIP_PRETRAINED=dfn5b

# --- BEiT3 Retrieval (real visual-search path for /users/singletextsearch) ---
# Required. Absolute paths to the runtime artifacts on this machine.
# These are NOT committed to Git (see .gitignore) and must be produced/
# copied onto the deployment machine ahead of time.
BEIT3_FAISS_INDEX_PATH=
BEIT3_GLOBAL_IDS_PATH=
BEIT3_VIDEO_METADATA_PATH=
BEIT3_INDEX_META_PATH=

BEIT3_CHECKPOINT_PATH=
BEIT3_TOKENIZER_PATH=

BEIT3_DEVICE=cuda
BEIT3_MAX_SEQ_LEN=64

# Optional: override auto-detected global_ids.parquet column names if they
# don't match the built-in candidate list (see BEiT3Retriever._detect_columns).
BEIT3_COL_VECTOR_ID=
BEIT3_COL_VIDEO_ID=
BEIT3_COL_FRAME_ID=
BEIT3_COL_FRAME_PATH=
BEIT3_COL_TIMESTAMP=
BEIT3_COL_NAMESPACE=

# --- Logging ---
LOG_LEVEL=INFO

# --- LLM / Agent (chat planner + translation fallback) ---
# Provider: auto, openai, openrouter, anthropic, nvidia, google
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MAX_TOKENS=512
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=AIC Backend
# Optional: dedicated model/max tokens for the /translate fallback
OPENROUTER_TRANSLATE_MODEL=
OPENROUTER_TRANSLATE_MAX_TOKENS=384
# Optional: enable OpenRouter to enrich Agent Search queries. Keep API keys server-side only.
AGENT_LLM_ENABLED=false
AGENT_LLM_MODEL=
AGENT_LLM_MAX_TOKENS=900
# Optional: verify and rerank top Agent Search candidates with an OpenRouter vision model.
AGENT_VLM_ENABLED=false
AGENT_VLM_MODEL=google/gemini-2.5-flash
AGENT_VLM_MAX_CANDIDATES=12
AGENT_VLM_BATCH_SIZE=4
AGENT_VLM_MAX_TOKENS=900
AGENT_VLM_TIMEOUT_SECONDS=45
AGENT_VLM_IMAGE_MAX_SIDE=768
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620
ANTHROPIC_MAX_TOKENS=2048
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_MAX_TOKENS=2048
NVIDIA_TOP_P=1.0
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-1.5-flash

# --- Chat memory ---
CHAT_HISTORY_MESSAGES=6
