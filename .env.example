# ============================================================
# AI Challenge 2025 Backend - Environment Variables
# ============================================================
# Copy this file to `.env` and fill in the values.
# All variables are optional — sensible defaults are provided.
# ============================================================

# --- Server Configuration ---
ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=3000

# --- Data Paths (absolute or relative to src/) ---
# Leave blank to use defaults under src/dict/ and src/data/
KEYFRAMES_ROOT=
MEDIA_INFO_PATH=
FEATURES_ROOT=
FAISS_INDEX_PATH=
METADATA_PATH=

# --- Video playback / frame capture ---
# ZIP archive OR directory of per-video media-info JSON (watch_url + length).
# `media-info-aic25-b1.zip` is a runtime asset that is NOT committed to Git;
# copy it onto the machine and point this at it. Leave blank to auto-detect
# `media-info-aic25-b1.zip` at the repo root, then `src/dict/media-info/`.
# ZIP archive OR directory of per-video map-keyframes CSV (authoritative FPS).
# Leave blank to use the committed `src/dict/map-keyframes.zip`.
MAP_KEYFRAMES_PATH=
# Optional JSON object mapping video_id -> playback offset in seconds
# (source_time = playback_time - offset). Default offset is 0 for every video;
# only set entries for videos whose YouTube timeline is verified to differ.
# Example: {"L21_V029": -172}
PLAYBACK_OFFSETS_JSON=

# --- Captured-frame previews (exact server-side still extraction) ---
# The Capture button extracts an exact still for the submitted frame from the
# YouTube watch_url in media-info, using `yt-dlp` (Python dependency) plus an
# FFmpeg binary, and needs outbound access to YouTube. All optional: without
# them the frame is still captured/exportable, only the preview image is
# omitted (preview_error explains why).
# Directory for generated WebP stills; blank -> .cache/video-captures/ at repo root.
VIDEO_CAPTURE_CACHE_PATH=
# FFmpeg binary name or absolute path.
VIDEO_CAPTURE_FFMPEG_BIN=ffmpeg
# Wall-clock limit (seconds) for one yt-dlp + FFmpeg extraction.
VIDEO_CAPTURE_EXTRACT_TIMEOUT_SECONDS=90
# Evict least-recently-used stills once the cache exceeds this many bytes (500 MB).
VIDEO_CAPTURE_CACHE_MAX_BYTES=524288000

# --- External Services ---
ELASTICSEARCH_URL=http://localhost:9200

# --- Model Configuration ---
CLIP_MODEL_NAME=ViT-H-14-quickgelu
CLIP_PRETRAINED=dfn5b

# Active visual embedding space. Keep beit3 until the Jina artifacts below are
# synced locally and an end-to-end query passes.
VISUAL_RETRIEVER=beit3

# --- Azure Blob Storage (S3-compatible data lake for 100GB keyframes & embeddings) ---
AZURE_STORAGE_ACCOUNT_NAME=aicstorage2025data
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_PRIMARY_KEY=
AZURE_BLOB_CONTAINER_KEYFRAMES=keyframes
AZURE_BLOB_CONTAINER_EMBEDDINGS=embeddings
AZURE_BLOB_CONTAINER_METADATA=metadata

# --- CORS ---
# Comma-separated list of allowed origins. Use "*" to allow any origin
# (credentials are disabled automatically in that case).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# --- BEiT3 Retrieval (real visual-search path for /users/singletextsearch) ---
# Required. Absolute paths to the runtime artifacts on this machine.
# These are NOT committed to Git (see .gitignore) and must be produced/
# copied onto the deployment machine ahead of time.
BEIT3_FAISS_INDEX_PATH=
BEIT3_GLOBAL_IDS_PATH=
BEIT3_VIDEO_METADATA_PATH=
BEIT3_INDEX_META_PATH=

BEIT3_CHECKPOINT_PATH=
BEIT3_TOKENIZER_PATH=

BEIT3_DEVICE=cuda
BEIT3_MAX_SEQ_LEN=64

# Optional: override auto-detected global_ids.parquet column names if they
# don't match the built-in candidate list (see BEiT3Retriever._detect_columns).
BEIT3_COL_VECTOR_ID=
BEIT3_COL_VIDEO_ID=
BEIT3_COL_FRAME_ID=
BEIT3_COL_FRAME_PATH=
BEIT3_COL_TIMESTAMP=
BEIT3_COL_NAMESPACE=

# --- Jina CLIP v2 Retrieval (fine-keyframe target path) ---
JINA_MODEL_NAME_OR_PATH=jinaai/jina-clip-v2
# Pin to the Hugging Face commit used for image embedding when known.
JINA_MODEL_REVISION=e10d47f5691d0454a0fb5d13f46f2199b74cb436
HCMAI_APP_DATA_DIR=
JINA_CACHE_DIR=
JINA_LOCAL_FILES_ONLY=true
JINA_DEVICE=cpu
JINA_TRUNCATE_DIM=1024
JINA_QUERY_TASK=retrieval.query
JINA_FAISS_INDEX_PATH=
JINA_GLOBAL_IDS_PATH=
JINA_VIDEO_METADATA_PATH=
JINA_INDEX_META_PATH=

# Optional KIS second-stage rerank through Jina's cloud multimodal API.
# It reranks only the first candidate pool returned by Jina CLIP and falls back
# to the original order if the API is unavailable. Do not commit the API key.
JINA_RERANKER_ENABLED=false
JINA_RERANKER_API_KEY=
JINA_RERANKER_BASE_URL=https://api.jina.ai/v1/rerank
JINA_RERANKER_MODEL=jina-reranker-m0
JINA_RERANKER_CANDIDATE_POOL=20
JINA_RERANKER_IMAGE_MAX_SIDE=768
JINA_RERANKER_TIMEOUT_SECONDS=45

# --- Logging ---
LOG_LEVEL=INFO

# --- LLM / Agent (chat planner + translation fallback) ---
# Provider: auto, openai, openrouter, anthropic, nvidia, google
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MAX_TOKENS=512
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=AIC Backend
# Optional: dedicated model/max tokens for the /translate fallback
OPENROUTER_TRANSLATE_MODEL=
OPENROUTER_TRANSLATE_MAX_TOKENS=384
# Optional: enable OpenRouter to enrich Agent Search queries. Keep API keys server-side only.
AGENT_LLM_ENABLED=false
AGENT_LLM_MODEL=
AGENT_LLM_MAX_TOKENS=900
# Optional: verify and rerank top Agent Search candidates with an OpenRouter vision model.
AGENT_VLM_ENABLED=false
AGENT_VLM_MODEL=google/gemini-2.5-flash
AGENT_VLM_MAX_CANDIDATES=12
AGENT_VLM_CANDIDATE_POOL=40
AGENT_VLM_PER_VIDEO_LIMIT=3
AGENT_VLM_BATCH_SIZE=4
AGENT_VLM_MAX_TOKENS=900
AGENT_VLM_TIMEOUT_SECONDS=45
AGENT_VLM_IMAGE_MAX_SIDE=768
AGENT_VLM_MAX_RETRIES=1
AGENT_VLM_RETRY_BACKOFF_SECONDS=0.5
# Cache keys include the model, enriched query/checklist, frame identity, and image file version.
AGENT_VLM_CACHE_ENABLED=true
# Leave blank to use .cache/agent_vlm_verdicts.json under the repository root.
AGENT_VLM_CACHE_PATH=
AGENT_VLM_CACHE_MAX_ENTRIES=5000
AGENT_VLM_CACHE_TTL_SECONDS=2592000
AGENT_MIN_VERIFICATION_SCORE=0.45
AGENT_REQUIRE_VLM_MATCH=true
# --- TRAKE ordered-event retrieval ---
TRAKE_RETRIEVAL_TOP_K=120
TRAKE_ADAPTIVE_RETRIEVAL_TOP_K=1500
TRAKE_ANCHOR_EXPANSION_ENABLED=true
TRAKE_ANCHOR_VIDEO_LIMIT=12
TRAKE_ANCHOR_TIMELINE_TOP_K=24
TRAKE_TRACE_CANDIDATES=false
TRAKE_TRACE_VIDEO_LIMIT=20
TRAKE_CANDIDATES_PER_EVENT_VIDEO=12
TRAKE_BEAM_WIDTH=40
TRAKE_MIN_EVENT_GAP_SECONDS=0
TRAKE_MAX_EVENT_GAP_SECONDS=300
TRAKE_MAX_SEQUENCE_SPAN_SECONDS=900
TRAKE_TEMPORAL_DECAY=0.001
TRAKE_CONSECUTIVE_COMPACT_SPAN_SECONDS=15
TRAKE_CONSECUTIVE_SPAN_DECAY=0.08
TRAKE_EVIDENCE_WINDOW_SECONDS=12
TRAKE_OCR_ENABLED=true
TRAKE_ASR_ENABLED=true
TRAKE_VLM_ENABLED=true
TRAKE_VLM_MAX_SEQUENCES=8
TRAKE_VLM_MAX_TOTAL_SEQUENCES=32
# --- Grounded video Q&A ---
QA_RETRIEVAL_POOL=120
QA_VISUAL_QUERY_LIMIT=8
QA_MAX_FRAMES=16
QA_PER_VIDEO_LIMIT=4
QA_EVENT_WINDOW_SECONDS=8
QA_MAX_EVIDENCE_GROUPS=12
QA_CONTEXT_FRAMES_PER_GROUP=2
QA_TEXT_EVIDENCE_TOP_K=12
QA_TEXT_RETRIEVAL_POOL=32
QA_EVIDENCE_WINDOW_SECONDS=15
QA_VLM_ENABLED=true
QA_CANDIDATE_ANSWERS_ENABLED=true
QA_CANDIDATE_MAX_VIDEOS=4
QA_CANDIDATE_FRAMES_PER_VIDEO=3
# A focused OCR/display pass runs only after the first pass finds relevant
# frames but cannot read a count or text value confidently.
QA_DETAIL_PASS_ENABLED=true
QA_DETAIL_MODEL=qwen/qwen3-vl-32b-instruct
QA_DETAIL_MAX_FRAMES=2
QA_DETAIL_GRID_SIZE=3
QA_DETAIL_IMAGE_MAX_SIDE=900
QA_VERIFY_ENABLED=true
QA_MIN_CONFIDENCE=0.55
QA_RETURN_BEST_GUESS=true
QA_UNCERTAIN_CONFIDENCE_CAP=0.49
QA_ANSWER_MAX_CHARS=100
QA_MAX_TOKENS=700
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620
ANTHROPIC_MAX_TOKENS=2048
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_MAX_TOKENS=2048
NVIDIA_TOP_P=1.0
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-1.5-flash

# --- Chat memory ---
CHAT_HISTORY_MESSAGES=6

# ============================================================
# Runtime configuration store
# ============================================================
# This .env is imported into a per-user SQLite store on first run
# (<app-data>/HCMAI2026/config.db). After that, the active revision in the
# store takes precedence over this file and the code defaults; edit config
# through the Settings UI / management API instead of here.
#   HCMAI_APP_DATA_DIR         override the per-user app-data directory
#   HCMAI_DISABLE_CONFIG_STORE =1 to ignore the store (pure .env behaviour)

# --- Legacy knobs promoted to first-class settings (were os.getenv) ---
KIS_VQA_RERANK=true
KIS_VQA_RERANK_CANDIDATES=24
KIS_EVENT_RECALL_K=300
KIS_VIDEO_RERANK_VIDEOS=8
KIS_VQA_FRAMES_PER_EVENT=2
KIS_VQA_THRESHOLD=0.55
TRAKE_ENABLE_VQA=false
TRAKE_VQA_MAX_SEQUENCES=5

# ============================================================
# Multi-provider AI gateway
# ============================================================
# When enabled, translation / Agent planner / VLM verifier route through the
# provider gateway. Two independent ordered fallback lists: Text and Vision.
# Model IDs are never hard-coded -- set them here / in the UI and confirm with
# the per-provider Test endpoint. API keys stay entirely server-side.
AI_GATEWAY_ENABLED=false
AI_TEXT_PRIORITY=nim,cerebras,groq,openrouter,kilo,gemini,cloudflare
AI_VISION_PRIORITY=gemini,openrouter,kilo,nim,cloudflare,groq,cerebras
AI_LOCAL_FALLBACK_ENABLED=true
AI_GATEWAY_MAX_TOKENS=1024

# NVIDIA NIM (hosted, OpenAI-compatible). Free tier = prototype only.
# https://docs.api.nvidia.com/nim/docs/run-anywhere
NIM_ENABLED=false
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_TEXT_MODEL=
NIM_VISION_MODEL=
NIM_TIMEOUT_SECONDS=45

CEREBRAS_ENABLED=false
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_TEXT_MODEL=
CEREBRAS_VISION_MODEL=
CEREBRAS_TIMEOUT_SECONDS=45

GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TEXT_MODEL=
GROQ_VISION_MODEL=
GROQ_TIMEOUT_SECONDS=45

# OpenRouter gateway view (reuses OPENROUTER_API_KEY / OPENROUTER_BASE_URL above)
OPENROUTER_ENABLED=false
OPENROUTER_VISION_MODEL=
OPENROUTER_TIMEOUT_SECONDS=45

# Gemini AI Studio (OpenAI-compatible). https://ai.google.dev/gemini-api/docs/openai
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_TEXT_MODEL=
GEMINI_VISION_MODEL=
GEMINI_TIMEOUT_SECONDS=45

# Cloudflare Workers AI (OpenAI-compatible; needs Account ID).
# https://developers.cloudflare.com/workers-ai/configuration/open-ai-compatibility/
CLOUDFLARE_ENABLED=false
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_TEXT_MODEL=
CLOUDFLARE_VISION_MODEL=
CLOUDFLARE_TIMEOUT_SECONDS=45

# Kilo AI Gateway (kilocode.ai) -- OpenRouter-compatible model aggregator.
# Base URL and model IDs are confirmed with the per-provider Test in the UI.
KILO_ENABLED=false
KILO_API_KEY=
KILO_BASE_URL=https://kilocode.ai/api/openrouter
KILO_TEXT_MODEL=
KILO_VISION_MODEL=
KILO_TIMEOUT_SECONDS=45

# ============================================================
# Cloud asset storage (dataset read from Azure Blob or S3-compatible)
# ============================================================
# Dataset is uploaded ahead of time with a versioned `hcmai-assets.json`
# manifest in the metadata container/bucket. Sync downloads + checksum-verifies
# artifacts into a local cache; keyframes are fetched on demand and LRU-cached.
CLOUD_ASSETS_ENABLED=false
CLOUD_ASSETS_PROVIDER=local
CLOUD_ASSETS_MANIFEST_KEY=hcmai-assets-jina.json
CLOUD_ASSETS_CACHE_PATH=
CLOUD_ASSETS_KEYFRAME_CACHE_MAX_BYTES=5368709120

# Azure Blob
# S3-compatible (AWS S3, Cloudflare R2, MinIO, ...)
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_METADATA_PREFIX=metadata/

# ============================================================
# Local runtime launcher
# ============================================================
LAUNCHER_FRONTEND_ENABLED=false
LAUNCHER_FRONTEND_DIR=
LAUNCHER_FRONTEND_PORT=5173
LAUNCHER_HEALTH_TIMEOUT_SECONDS=60
LAUNCHER_HEALTH_POLL_INTERVAL_SECONDS=1
