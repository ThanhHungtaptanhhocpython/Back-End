# ============================================================
# AI Challenge 2025 Backend - Environment Variables
# ============================================================
# Copy this file to `.env` and fill in the values.
# All variables are optional — sensible defaults are provided.
# ============================================================

# --- Server Configuration ---
ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=3000

# --- Data Paths (absolute or relative to src/) ---
# Leave blank to use defaults under src/dict/ and src/data/
FAISS_INDEX_PATH=
METADATA_PATH=
KEYFRAMES_ROOT=
FEATURES_ROOT=
# --- External Services ---
ELASTICSEARCH_URL=http://localhost:9200

# --- Model Configuration ---
CLIP_MODEL_NAME=ViT-H-14-quickgelu
CLIP_PRETRAINED=dfn5b

# --- Logging ---
LOG_LEVEL=INFO
