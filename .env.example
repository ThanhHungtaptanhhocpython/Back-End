# ============================================================
# AI Challenge 2025 Backend - Environment Variables
# ============================================================
# Copy this file to `.env` and fill in the values.
# All variables are optional — sensible defaults are provided.
# ============================================================

# --- Server Configuration ---
ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=3000

# --- Data Paths (absolute or relative to src/) ---
# Leave blank to use defaults under src/dict/ and src/data/
FAISS_INDEX_PATH=
METADATA_PATH=
KEYFRAMES_ROOT=
MEDIA_INFO_PATH=
FEATURES_ROOT=
# --- External Services ---
ELASTICSEARCH_URL=http://localhost:9200

# --- CORS ---
# Comma-separated list of allowed origins. Use "*" to allow any origin
# (credentials are disabled automatically in that case).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# --- Model Configuration ---
CLIP_MODEL_NAME=ViT-H-14-quickgelu
CLIP_PRETRAINED=dfn5b

# --- BEiT3 Retrieval (real visual-search path for /users/singletextsearch) ---
# Required. Absolute paths to the runtime artifacts on this machine.
# These are NOT committed to Git (see .gitignore) and must be produced/
# copied onto the deployment machine ahead of time.
BEIT3_FAISS_INDEX_PATH=
BEIT3_GLOBAL_IDS_PATH=
BEIT3_VIDEO_METADATA_PATH=
BEIT3_INDEX_META_PATH=

BEIT3_CHECKPOINT_PATH=
BEIT3_TOKENIZER_PATH=

BEIT3_DEVICE=cuda
BEIT3_MAX_SEQ_LEN=64

# Optional: override auto-detected global_ids.parquet column names if they
# don't match the built-in candidate list (see BEiT3Retriever._detect_columns).
BEIT3_COL_VECTOR_ID=
BEIT3_COL_VIDEO_ID=
BEIT3_COL_FRAME_ID=
BEIT3_COL_FRAME_PATH=
BEIT3_COL_TIMESTAMP=
BEIT3_COL_NAMESPACE=

# --- Logging ---
LOG_LEVEL=INFO

# --- LLM / Agent (chat planner + translation fallback) ---
# Provider: auto, openai, openrouter, anthropic, nvidia, google
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MAX_TOKENS=512
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=AIC Backend
# Optional: dedicated model/max tokens for the /translate fallback
OPENROUTER_TRANSLATE_MODEL=
OPENROUTER_TRANSLATE_MAX_TOKENS=384
# Optional: enable OpenRouter to enrich Agent Search queries. Keep API keys server-side only.
AGENT_LLM_ENABLED=false
AGENT_LLM_MODEL=
AGENT_LLM_MAX_TOKENS=900
# Optional: verify and rerank top Agent Search candidates with an OpenRouter vision model.
AGENT_VLM_ENABLED=false
AGENT_VLM_MODEL=google/gemini-2.5-flash
AGENT_VLM_MAX_CANDIDATES=12
AGENT_VLM_CANDIDATE_POOL=40
AGENT_VLM_PER_VIDEO_LIMIT=3
AGENT_VLM_BATCH_SIZE=4
AGENT_VLM_MAX_TOKENS=900
AGENT_VLM_TIMEOUT_SECONDS=45
AGENT_VLM_IMAGE_MAX_SIDE=768
AGENT_VLM_MAX_RETRIES=1
AGENT_VLM_RETRY_BACKOFF_SECONDS=0.5
# Cache keys include the model, enriched query/checklist, frame identity, and image file version.
AGENT_VLM_CACHE_ENABLED=true
# Leave blank to use .cache/agent_vlm_verdicts.json under the repository root.
AGENT_VLM_CACHE_PATH=
AGENT_VLM_CACHE_MAX_ENTRIES=5000
AGENT_VLM_CACHE_TTL_SECONDS=2592000
# --- TRAKE ordered-event retrieval ---
TRAKE_RETRIEVAL_TOP_K=120
TRAKE_CANDIDATES_PER_EVENT_VIDEO=12
TRAKE_BEAM_WIDTH=40
TRAKE_MIN_EVENT_GAP_SECONDS=0
TRAKE_MAX_EVENT_GAP_SECONDS=300
TRAKE_MAX_SEQUENCE_SPAN_SECONDS=900
TRAKE_TEMPORAL_DECAY=0.01
TRAKE_EVIDENCE_WINDOW_SECONDS=12
TRAKE_OCR_ENABLED=true
TRAKE_ASR_ENABLED=true
TRAKE_VLM_ENABLED=true
TRAKE_VLM_MAX_SEQUENCES=5
# --- Grounded video Q&A ---
QA_RETRIEVAL_POOL=120
QA_VISUAL_QUERY_LIMIT=8
QA_MAX_FRAMES=16
QA_PER_VIDEO_LIMIT=4
QA_EVENT_WINDOW_SECONDS=8
QA_MAX_EVIDENCE_GROUPS=12
QA_CONTEXT_FRAMES_PER_GROUP=2
QA_TEXT_EVIDENCE_TOP_K=12
QA_EVIDENCE_WINDOW_SECONDS=15
QA_VLM_ENABLED=true
# A focused OCR/display pass runs only after the first pass finds relevant
# frames but cannot read a count or text value confidently.
QA_DETAIL_PASS_ENABLED=true
QA_DETAIL_MODEL=qwen/qwen3-vl-32b-instruct
QA_DETAIL_MAX_FRAMES=2
QA_DETAIL_GRID_SIZE=3
QA_DETAIL_IMAGE_MAX_SIDE=900
QA_VERIFY_ENABLED=true
QA_MIN_CONFIDENCE=0.55
QA_RETURN_BEST_GUESS=true
QA_UNCERTAIN_CONFIDENCE_CAP=0.49
QA_ANSWER_MAX_CHARS=100
QA_MAX_TOKENS=700
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620
ANTHROPIC_MAX_TOKENS=2048
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_MAX_TOKENS=2048
NVIDIA_TOP_P=1.0
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-1.5-flash

# --- Chat memory ---
CHAT_HISTORY_MESSAGES=6
